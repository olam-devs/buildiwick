<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Never serve dotfiles directly (.env, .git, etc.) — belt and suspenders
    # alongside the server-level protection already confirmed on this host.
    RewriteRule ^\.(?!well-known) - [F,L]

    # Serve real static files from public/ transparently
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Serve real directories from public/ transparently
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Route everything else through Laravel's front controller
    RewriteRule ^ public/index.php [L]
</IfModule>
